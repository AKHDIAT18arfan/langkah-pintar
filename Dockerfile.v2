# --- Tahap 1: Build aplikasi Vite ---
FROM node:20-alpine AS builder
WORKDIR /app

# Salin konfigurasi dependensi
COPY package*.json ./
RUN npm install

# Salin seluruh source code lalu build
COPY . .
RUN npm run build

# --- Tahap 2: Sajikan dengan Nginx ---
FROM nginx:alpine
# Ambil hasil build (folder dist) dari tahap 1 ke Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]